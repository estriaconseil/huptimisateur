# Copier vers .env.local
#
# Supabase — https://supabase.com/dashboard/project/_/settings/api
#
# Nouveau modèle de clés (dashboard actuel) :
# - URL du projet : inchangée (https://<ref>.supabase.co)
# - « Publishable key » (préfixe sb_publishable_…) → NEXT_PUBLIC_SUPABASE_ANON_KEY
# - « Secret key » / service_role → SUPABASE_SERVICE_ROLE_KEY (serveur uniquement)
#
NEXT_PUBLIC_SUPABASE_URL=
# Valeur = clé Publishable / anon du dashboard (pas la Secret)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obligatoire en prod — clé service_role (sb_secret_… ou legacy service_role).
# Ne jamais préfixer avec NEXT_PUBLIC ni l’exposer au navigateur.
# Utilisée par : admin users, cron auto-complete, backup interruption, cache distance.
SUPABASE_SERVICE_ROLE_KEY=

# Obligatoire en prod — protège /api/cron/* (Authorization: Bearer …)
CRON_SECRET=

# Resend — envoi PDF backup interruption
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Maps — activer « Places API (New) » + « Distance Matrix API » (suggestions) ; facturation si requis.
# Autocomplete : PlaceAutocompleteElement (@googlemaps/js-api-loader). Suggestions : Distance Matrix côté serveur (même clé en MVP).
# https://console.cloud.google.com/apis/library
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Couper la facturation Distance Matrix (tri par proximité off, autocomplete Places OK). Redémarrer le serveur.
# DISABLE_DISTANCE_MATRIX=true
#
# Simulation sans appeler Google : log URL + compteur d'éléments facturables dans le terminal.
# L'app utilise Haversine à la place. Redémarrer le serveur après changement.
# DISTANCE_MATRIX_DRY_RUN=true
# Ignorer cache Supabase/mémoire pour simuler un prospect jamais vu (tous les éléments comptés).
# DISTANCE_MATRIX_DRY_RUN_IGNORE_CACHE=true
